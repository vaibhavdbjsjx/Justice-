    "charcoal-deep": "#12181F",
    "success-sage": "#7A9471",
    "alert-terracotta": "#C1654A"
  },
  "semantic": {
    "light": {
      "background": "#FAF7F2",
      "surface": "#FFFFFF",
      "surface-raised": "#FFFFFF",
      "surface-sunken": "#F4EFE7",
      "foreground": "#1A1A1A",
      "muted": "#6B6B6B",
      "muted-strong": "#4A4A4A",
      "border": "#E7E1D8",
      "border-strong": "#D8CFC1",
      "primary": "#0B1D2E",
      "primary-hover": "#123049",
      "primary-foreground": "#FAF7F2",
      "accent": "#B08D57",
      "accent-hover": "#9C7C4B",
      "accent-foreground": "#1A1A1A",
      "success": "#7A9471",
      "alert": "#C1654A",
      "ring": "#B08D57"
    },
    "dark": {
      "background": "#12181F",
      "surface": "#1B232C",
      "surface-raised": "#222C36",
      "surface-sunken": "#0E141A",
      "foreground": "#F2F0EC",
      "muted": "#9A9A94",
      "muted-strong": "#C2C2BA",
      "border": "#2A343E",
      "border-strong": "#3A4650",
      "primary": "#1D3E5C",
      "primary-hover": "#24496B",
      "primary-foreground": "#F2F0EC",
      "accent": "#C6A56E",
      "accent-hover": "#D4B783",
      "accent-foreground": "#12181F",
      "success": "#8FAA85",
      "alert": "#D0765B",
      "ring": "#C6A56E"
