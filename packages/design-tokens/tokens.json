  "typography": {
    "font-serif": "Fraunces",
    "font-sans": "Inter",
    "scale": {
      "display": { "size": "3rem", "line": "1.05", "weight": 500 },
      "h1": { "size": "2.25rem", "line": "1.15", "weight": 500 },
      "h2": { "size": "1.75rem", "line": "1.2", "weight": 500 },
      "h3": { "size": "1.375rem", "line": "1.3", "weight": 600 },
      "body": { "size": "1rem", "line": "1.6", "weight": 400 },
      "legal-prose-line-height": "1.75",
      "small": { "size": "0.875rem", "line": "1.5", "weight": 400 },
      "caption": { "size": "0.75rem", "line": "1.4", "weight": 500 }
    }
  },
  "radius": { "sm": "6px", "md": "8px", "lg": "10px", "xl": "12px", "2xl": "16px" },
  "motion": {
    "ease-refined": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-in-out-soft": "cubic-bezier(0.4, 0, 0.2, 1)",
    "duration-fast": "140ms",
