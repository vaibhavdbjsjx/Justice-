      "accent-foreground": "#FFFFFF",
      "success": "#6F8F66",
      "alert": "#B02E1F",
      "ring": "#C15F3C"
    },
    "dark": {
      "background": "#1F1E1D",
      "surface": "#262624",
      "surface-raised": "#2F2D2A",
      "surface-sunken": "#171615",
      "foreground": "#F5F4EF",
