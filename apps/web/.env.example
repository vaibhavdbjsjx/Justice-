# ---- Supabase (Phase 1) --------------------------------------------------
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider (Phase 3+) ----------------------------------------------
# Set ONE of these. Swapping to a stronger key needs no code change.
#
# Use a PAID key for real users. Google's terms forbid sending personal data to
# unpaid Gemini keys, allow human review of unpaid content, and forbid serving
# the UK, EEA, and Switzerland from them.
GEMINI_API_KEY=
# Optional model override. Default: gemini-flash-latest, Google's rolling alias.
# For the flagship reasoning model on a paid key: gemini-4-argon
# Set to true on a paid key; leaves out the free-tier data notice.
# GEMINI_PAID_TIER=true
# GEMINI_MODEL=
# Web-grounded answers with sources are on for Gemini. Set to off to disable.
# AI_WEB_SEARCH=on
#
# OpenAI alternative (used only if GEMINI_API_KEY is unset):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra

# ---- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support / legal contact addresses (shown on Support, Privacy, Terms pages).
# Create real, monitored mailboxes before App Store submission.
NEXT_PUBLIC_SUPPORT_EMAIL=support@lexa.app
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@lexa.app
NEXT_PUBLIC_LEGAL_EMAIL=legal@lexa.app

# ---- Payments mode (App Store compliance) --------------------------------
# Apple Guideline 3.1.1: digital subscriptions in an iOS/Mac App Store build
# MUST use In-App Purchase, not Stripe. For those builds set this to "false":
# every account gets full access, Billing is hidden, no Stripe upgrade walls.
# Leave unset (or "true") for the public web build, which sells via Stripe.
# NEXT_PUBLIC_PAYMENTS_ENABLED=true

# ---- App Store purchases ---------------------------------------------------
# The numeric Apple ID on the app's App Store Connect page. Real purchases can't
# be verified until this is set. Sandbox purchases, used by App Review, work
# without it.
# APPLE_APP_ID=
# Only if the bundle ID ever changes (default: com.vaibhavsg.lexa).
# APPLE_BUNDLE_ID=

# ---- Auth providers ------------------------------------------------------
# Enabled providers: Apple (Sign in with Apple) + email. Configure Apple in
# Supabase Auth → Providers using your Apple Developer Services ID + key.
# (Google OAuth is intentionally NOT used.)

# ---- Stripe (Phase 10) --------------------------------------------------
# Billing activates when the secret key + both price IDs are set.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Recurring prices created in the Stripe dashboard (Plus $9.99, Professional $39.99):
# STRIPE_PRICE_PLUS=
# STRIPE_PRICE_PROFESSIONAL=
# OpenAI-style base override for local mocks/tests (default https://api.stripe.com):
# STRIPE_API_BASE=
