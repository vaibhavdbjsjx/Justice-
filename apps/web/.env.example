# ---- Supabase (Phase 1) --------------------------------------------------
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider (Phase 3+) ----------------------------------------------
# Chat runs on OpenAI (owner decision, 2026-07-03); the provider layer in
# src/lib/ai/ keeps a switch back to Claude a one-file change.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o)
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=

# ---- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe (Phase 10) --------------------------------------------------
# Billing activates when the secret key + both price IDs are set.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Recurring prices created in the Stripe dashboard (Plus $14.99, Professional $49.99):
# STRIPE_PRICE_PLUS=
# STRIPE_PRICE_PROFESSIONAL=
# OpenAI-style base override for local mocks/tests (default https://api.stripe.com):
# STRIPE_API_BASE=
