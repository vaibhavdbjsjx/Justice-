# ---- Supabase (Phase 1) --------------------------------------------------
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider (Phase 3+) ----------------------------------------------
# Chat runs on OpenAI (owner decision, 2026-07-03); the provider layer in
# src/lib/ai/ keeps a switch back to Claude a one-file change.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o)
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=

# ---- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support / legal contact addresses (shown on Support, Privacy, Terms pages).
# Create real, monitored mailboxes before App Store submission.
NEXT_PUBLIC_SUPPORT_EMAIL=support@justice.app
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@justice.app
NEXT_PUBLIC_LEGAL_EMAIL=legal@justice.app

# ---- Payments mode (App Store compliance) --------------------------------
# Apple Guideline 3.1.1: digital subscriptions in an iOS/Mac App Store build
# MUST use In-App Purchase, not Stripe. For those builds set this to "false":
# every account gets full access, Billing is hidden, no Stripe upgrade walls.
# Leave unset (or "true") for the public web build, which sells via Stripe.
# NEXT_PUBLIC_PAYMENTS_ENABLED=true

# ---- Auth providers ------------------------------------------------------
# Enabled providers: Apple (Sign in with Apple) + email. Configure Apple in
# Supabase Auth → Providers using your Apple Developer Services ID + key.
# (Google OAuth is intentionally NOT used.)

# ---- Stripe (Phase 10) --------------------------------------------------
# Billing activates when the secret key + both price IDs are set.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Recurring prices created in the Stripe dashboard (Plus $9.99, Professional $39.99):
# STRIPE_PRICE_PLUS=
# STRIPE_PRICE_PROFESSIONAL=
# OpenAI-style base override for local mocks/tests (default https://api.stripe.com):
# STRIPE_API_BASE=
